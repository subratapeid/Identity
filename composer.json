{
    "name": "pagelyne/identity",
    "version": "1.0.0",
    "description": "Pagelyne Identity Laravel Plugin",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "spatie/laravel-permission": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Pagelyne\\Identity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pagelyne\\Identity\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pagelyne\\Identity\\Providers\\IdentityServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}